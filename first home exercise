import csv
import xmltodict
from Bio import Entrez


def fetch_pubmed_ids(query, max_results=20):
    handle = Entrez.esearch(db="pubmed", term=query, retmax=max_results)
    record = Entrez.read(handle)
    handle.close()
    return record["IdList"]

def fetch_pubmed_details(id_list):
    ids = ",".join(id_list)
    handle = Entrez.efetch(db="pubmed", id=ids, retmode="xml")
    records = Entrez.read(handle)
    handle.close()
    return records

def is_pharma_affiliation(affiliation):
    keywords = ["pharma", "pharmaceutical", "biotech", "biosciences", "biotechnology"]
    if affiliation:
        return any(kw.lower() in affiliation.lower() for kw in keywords)
    return False

